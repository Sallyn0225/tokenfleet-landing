---
/**
 * FeaturedModels.astro — 5-up Featured Models gallery.
 *
 * Layout: left ~32% section title + intro link, right ~68% asymmetric model
 * grid. Each card = neutral surface +
 * SVG brand mark watermark + compact logo chip + modality eyebrow + mono
 * model id (display-md, weight 300) + mono token cost.
 */

import { featuredModels, totalModelCount } from '../data/models.ts';
---

<section class="featured" id="models" aria-labelledby="featured-title">
  <div class="container featured__inner">
    <div class="featured__lede" data-reveal>
      <span class="eyebrow eyebrow--mute">MODELS GALLERY</span>
      <h2 class="featured__title" id="featured-title">
        <span class="mono featured__num">{totalModelCount}</span> 个生产级模型，<br />
        一份计费。
      </h2>
      <p class="featured__body">
        从 LLM、图像、视频到音频，全部走同一个 endpoint 与同一个对公账户。
      </p>
      <a href="/#why" class="link featured__link">
        查看全部模型
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M4 2.5l3.5 3.5L4 9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <ul class="featured__taxonomy mono">
        <li>LLM</li>
        <li>图像</li>
        <li>视频</li>
        <li>音频</li>
      </ul>
    </div>

    <ol class="featured__grid" data-reveal>
      {featuredModels.map((m, i) => (
        <li
          class="modelcard"
          data-modality={m.modality}
          data-index={i}
        >
          <img class="modelcard__watermark" src={m.logoSrc} alt="" loading="lazy" aria-hidden="true" />
          <div class="modelcard__top">
            <span class="modelcard__logo">
              <img src={m.logoSrc} alt={m.logoAlt} loading="lazy" />
            </span>
            <span class="modelcard__vendor">
              {m.vendor}
            </span>
            <span class="modelcard__modality mono">
              {m.modalityLabel}
            </span>
          </div>
          <div class="modelcard__body">
            <p class="modelcard__id mono">{m.id}</p>
            <p class="modelcard__blurb">{m.blurb}</p>
          </div>
          <p class="modelcard__price mono">
            {m.priceLabel}
          </p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .featured {
    background: var(--color-canvas-soft);
    border-top: 1px solid var(--color-hairline);
  }

  .featured__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.55fr) minmax(0, 1.2fr);
    gap: clamp(40px, 5vw, 72px);
    align-items: start;
  }

  .featured__lede {
    position: sticky;
    top: 96px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .featured__title {
    font-size: var(--type-display-xl-size);
    line-height: var(--type-display-xl-line);
    letter-spacing: var(--type-display-xl-track);
    font-weight: var(--weight-thin);
    color: var(--color-ink);
    margin-top: 4px;
  }

  .featured__num {
    font-weight: var(--weight-medium);
    color: var(--color-primary);
    font-size: 0.95em;
  }

  .featured__body {
    color: var(--color-ink-secondary);
    font-size: var(--type-body-md-size);
    line-height: 1.6;
    max-width: 32ch;
  }

  .featured__link {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 4px;
  }

  .featured__taxonomy {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 0;
    margin-top: 8px;
    padding-top: 20px;
    border-top: 1px solid var(--color-hairline);
    color: var(--color-ink-mute);
    font-size: 12px;
    letter-spacing: 0.04em;
  }

  .featured__taxonomy li {
    padding: 4px 14px;
    border-right: 1px solid var(--color-hairline);
  }
  .featured__taxonomy li:first-child { padding-left: 0; }
  .featured__taxonomy li:last-child { border-right: 0; padding-right: 0; }

  /* ── grid: asymmetric on desktop ──────────────────────────────────────── */
  .featured__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }

  /* card 1 (Anthropic) takes 3 cols on desktop, others fill in */
  .modelcard {
    border-radius: var(--radius-lg);
    padding: 22px 22px 24px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-height: 212px;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.98), rgba(246, 249, 252, 0.72)),
      var(--color-canvas);
    border: 1px solid var(--color-hairline);
    color: var(--color-ink);
    box-shadow: var(--shadow-1);
    transition: transform 320ms var(--ease-out-quart),
                border-color 320ms var(--ease-out-quart),
                box-shadow 320ms var(--ease-out-quart);
    grid-column: span 2;
  }

  /* hover lift only */
  .modelcard:hover {
    transform: translateY(-3px);
    border-color: rgba(83, 58, 253, 0.22);
    box-shadow: var(--shadow-2);
  }

  .modelcard::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 96% 94%, rgba(83, 58, 253, 0.055), transparent 34%),
      linear-gradient(135deg, rgba(255,255,255,0.66) 0%, rgba(255,255,255,0) 58%);
    z-index: 0;
    pointer-events: none;
  }

  .modelcard__watermark {
    position: absolute;
    right: 14px;
    bottom: 18px;
    width: clamp(58px, 6vw, 76px);
    height: clamp(58px, 6vw, 76px);
    object-fit: contain;
    opacity: 0.075;
    color: var(--color-ink);
    z-index: 1;
    transform: scale(1);
    transform-origin: 78% 78%;
    transition: transform 420ms var(--ease-out-quart),
                opacity 420ms var(--ease-out-quart);
    pointer-events: none;
  }

  .modelcard:hover .modelcard__watermark {
    transform: scale(1.18);
    opacity: 0.13;
  }

  .modelcard__top {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    position: relative;
    z-index: 2;
  }

  .modelcard__logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: var(--color-canvas-soft);
    border: 1px solid var(--color-hairline);
    flex-shrink: 0;
  }

  .modelcard__logo img {
    width: 16px;
    height: 16px;
    object-fit: contain;
    color: var(--color-ink);
  }

  .modelcard__vendor {
    font-size: 13px;
    letter-spacing: -0.01em;
    color: var(--color-ink-secondary);
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .modelcard__modality {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 3px 8px;
    border: 1px solid currentColor;
    border-radius: var(--radius-pill);
    color: var(--color-ink-mute);
    flex-shrink: 0;
  }

  .modelcard__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 10px;
    position: relative;
    z-index: 2;
  }

  .modelcard__id {
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: var(--weight-medium);
    word-break: break-all;
  }

  .modelcard__blurb {
    font-size: 13px;
    line-height: 1.45;
    color: var(--color-ink-secondary);
  }

  .modelcard__price {
    font-size: 11px;
    letter-spacing: -0.005em;
    border-top: 1px solid currentColor;
    padding-top: 14px;
    margin-top: auto;
    color: var(--color-ink-mute);
    position: relative;
    z-index: 2;
  }

  /* ── responsive ───────────────────────────────────────────────────────── */
  @media (max-width: 1280px) {
    .featured__inner {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .featured__lede {
      position: static;
      max-width: 540px;
    }
    .featured__grid { grid-template-columns: repeat(6, minmax(0, 1fr)); }
  }

  @media (max-width: 900px) {
    .modelcard {
      grid-column: span 3;
    }
  }

  @media (max-width: 720px) {
    .featured__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
    .modelcard {
      grid-column: span 1;
      min-height: 196px;
      padding: 18px 16px 20px;
      gap: 16px;
    }
    .modelcard__id { font-size: 17px; }
  }

  @media (max-width: 520px) {
    .featured__grid {
      grid-template-columns: 1fr;
    }
    .modelcard {
      min-height: 184px;
    }
  }
</style>
