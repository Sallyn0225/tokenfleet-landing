---
/**
 * TopNav.astro — minimal nav floating over the mesh hero.
 *
 * Left: wordmark.
 * Center (desktop): 模型 · 文档 · 企业服务 3 sans nav links.
 * Right: 登录 (text), 开始接入 (indigo pill).
 *
 * Mobile (<768px): wordmark + indigo pill + hamburger trigger that toggles
 * a vertical drawer (CSS :target, no JS dependency).
 */

import Wordmark from './Wordmark.astro';
import { i18n, localePath, locales, type Locale } from '../i18n.ts';

interface Props {
  locale?: Locale;
  currentPath?: string;
}

const { locale = 'zh', currentPath = '/' } = Astro.props as Props;
const t = i18n[locale];
const navLinks = [
  { href: localePath(locale, '/models'), label: t.nav.links.models },
  {
    href: 'https://docs.tokenfleet.ai',
    label: t.nav.links.docs,
    external: true,
  },
  {
    href: `${localePath(locale, '/')}#enterprise`,
    label: t.nav.links.enterprise,
  },
];
const languageOptions = locales.map((item) => ({
  locale: item,
  label: i18n[item].localeName,
  href: localePath(item, currentPath),
  current: item === locale,
}));
---

<header class="nav" role="banner">
  <div class="container nav__inner">
    <Wordmark size="md" class="nav__brand" locale={locale} />

    <nav class="nav__links" aria-label={t.nav.aria}>
      <ul>
        {
          navLinks.map(({ href, label, external }) => (
            <li>
              <a
                href={href}
                class="nav__link"
                {...(external
                  ? { target: '_blank', rel: 'noopener noreferrer' }
                  : {})}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="nav__cta">
      <details class="nav__language">
        <summary class="nav__language-trigger">
          <span>{t.languageLabel}</span>
          <span class="nav__language-current">{t.localeName}</span>
          <svg
            width="12"
            height="12"
            viewBox="0 0 12 12"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M3 4.5 6 7.5 9 4.5"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </summary>
        <ul class="nav__language-menu" aria-label={t.languageLabel}>
          {
            languageOptions.map((option) => (
              <li>
                <a
                  href={option.href}
                  class={`nav__language-option${option.current ? ' is-current' : ''}`}
                  aria-current={option.current ? 'true' : undefined}
                >
                  {option.label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
      <a href="https://tokenfleet.ai/login" class="nav__signin" rel="noopener"
        >{t.nav.signIn}</a
      >
      <a
        href="https://tokenfleet.ai/console"
        class="btn btn--primary btn--sm"
        rel="noopener"
      >
        {t.nav.start}
      </a>
    </div>

    <button
      class="nav__hamburger"
      type="button"
      aria-controls="mobile-drawer"
      aria-expanded="false"
      aria-label={t.nav.openMenu}
      data-nav-toggle
      data-open-label={t.nav.openMenu}
      data-close-label={t.nav.closeMenu}
    >
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="nav__drawer" id="mobile-drawer" data-nav-drawer hidden>
    <ul>
      {
        navLinks.map(({ href, label, external }) => (
          <li>
            <a
              href={href}
              class="nav__drawer-link"
              {...(external
                ? { target: '_blank', rel: 'noopener noreferrer' }
                : {})}
            >
              {label}
            </a>
          </li>
        ))
      }
      <li class="nav__drawer-cta">
        <div class="nav__drawer-language">
          <p class="nav__drawer-language-title mono">{t.languageLabel}</p>
          <div class="nav__drawer-language-list">
            {
              languageOptions.map((option) => (
                <a
                  href={option.href}
                  class={`nav__drawer-language-option${option.current ? ' is-current' : ''}`}
                  aria-current={option.current ? 'true' : undefined}
                >
                  {option.label}
                </a>
              ))
            }
          </div>
        </div>
        <a
          href="https://tokenfleet.ai/login"
          class="btn btn--outline nav__drawer-button">{t.nav.signIn}</a
        >
        <a
          href="https://tokenfleet.ai/console"
          class="btn btn--primary nav__drawer-button">{t.nav.start}</a
        >
      </li>
    </ul>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    background: rgba(255, 255, 255, 0.74);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid transparent;
    transition:
      border-color var(--motion-base) var(--ease-out-quart),
      background-color var(--motion-base) var(--ease-out-quart);
  }

  .nav[data-scrolled='true'] {
    border-bottom-color: var(--color-hairline);
    background: rgba(255, 255, 255, 0.92);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 64px;
  }

  .nav__brand {
    flex-shrink: 0;
  }

  .nav__links {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .nav__links ul {
    display: flex;
    gap: 36px;
    align-items: center;
  }

  .nav__link {
    color: var(--color-ink-secondary);
    font-size: var(--type-body-md-size);
    font-weight: var(--weight-regular);
    letter-spacing: -0.005em;
    padding: 6px 0;
    border-bottom: 1px solid transparent;
    transition:
      color var(--motion-base) var(--ease-out-quart),
      border-color var(--motion-base) var(--ease-out-quart);
  }

  .nav__link:hover {
    color: var(--color-ink);
    border-bottom-color: var(--color-ink);
  }

  .nav__cta {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-shrink: 0;
  }

  .nav__signin {
    font-size: var(--type-body-md-size);
    color: var(--color-ink-secondary);
    padding: 6px 10px;
    border-radius: var(--radius-sm);
    transition: color var(--motion-base) var(--ease-out-quart);
  }

  .nav__signin:hover {
    color: var(--color-ink);
  }

  .nav__language {
    position: relative;
  }

  .nav__language-trigger {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 34px;
    padding: 6px 10px;
    border-radius: var(--radius-sm);
    color: var(--color-ink-secondary);
    font-size: var(--type-body-md-size);
    list-style: none;
    cursor: pointer;
    transition:
      color var(--motion-base) var(--ease-out-quart),
      background-color var(--motion-base) var(--ease-out-quart);
  }

  .nav__language-trigger::-webkit-details-marker {
    display: none;
  }

  .nav__language-trigger:hover,
  .nav__language[open] .nav__language-trigger {
    color: var(--color-ink);
    background: var(--color-canvas-soft);
  }

  .nav__language-current {
    color: var(--color-ink);
    font-weight: var(--weight-medium);
  }

  .nav__language[open] .nav__language-trigger svg {
    transform: rotate(180deg);
  }

  .nav__language-trigger svg {
    transition: transform var(--motion-base) var(--ease-out-quart);
  }

  .nav__language-menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    z-index: var(--z-overlay);
    min-width: 148px;
    padding: 6px;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.98);
    box-shadow: var(--shadow-2);
  }

  .nav__language-option {
    display: flex;
    align-items: center;
    min-height: 34px;
    padding: 0 10px;
    border-radius: var(--radius-sm);
    color: var(--color-ink-secondary);
    font-size: 13px;
    transition:
      color var(--motion-base) var(--ease-out-quart),
      background-color var(--motion-base) var(--ease-out-quart);
  }

  .nav__language-option:hover {
    color: var(--color-ink);
    background: var(--color-canvas-soft);
  }

  .nav__language-option.is-current {
    color: var(--color-primary);
    background: var(--color-primary-bg-subdued);
    font-weight: var(--weight-medium);
  }

  .nav__hamburger {
    display: none;
    width: 36px;
    height: 36px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    border-radius: var(--radius-sm);
    transition: background-color var(--motion-base) var(--ease-out-quart);
  }

  .nav__hamburger span {
    display: block;
    width: 18px;
    height: 1.5px;
    background: var(--color-ink);
    border-radius: 999px;
    transition:
      transform var(--motion-base) var(--ease-out-quart),
      opacity var(--motion-base) var(--ease-out-quart);
  }

  .nav__hamburger[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }
  .nav__hamburger[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }
  .nav__hamburger[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  .nav__drawer {
    position: fixed;
    inset: 64px 0 0 0;
    z-index: var(--z-overlay);
    min-height: calc(100vh - 64px);
    min-height: calc(100dvh - 64px);
    overflow-y: auto;
    background:
      linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.98),
        rgba(246, 249, 252, 0.98)
      ),
      var(--color-canvas);
    padding: 24px var(--gutter);
    border-top: 1px solid var(--color-hairline);
    box-shadow: 0 18px 40px rgba(0, 55, 112, 0.12);
    animation: drawer-in 220ms var(--ease-out-quart);
  }

  .nav__drawer ul {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .nav__drawer-link {
    display: block;
    padding: 14px 16px;
    font-size: 17px;
    color: var(--color-ink);
    border-radius: var(--radius-md);
  }

  .nav__drawer-link:hover {
    background: var(--color-canvas-soft);
  }

  .nav__drawer-cta {
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid var(--color-hairline);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .nav__drawer-button {
    width: 100%;
    min-height: 46px;
    padding: 0 18px;
    font-size: var(--type-button-md-size);
  }

  .nav__drawer-language {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-bottom: 4px;
  }

  .nav__drawer-language-title {
    color: var(--color-ink-mute);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .nav__drawer-language-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .nav__drawer-language-option {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 0 12px;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    color: var(--color-ink-secondary);
    background: var(--color-canvas);
    font-size: 13px;
    transition:
      color var(--motion-base) var(--ease-out-quart),
      border-color var(--motion-base) var(--ease-out-quart),
      background-color var(--motion-base) var(--ease-out-quart);
  }

  .nav__drawer-language-option:hover {
    color: var(--color-ink);
    border-color: var(--color-hairline-strong);
  }

  .nav__drawer-language-option.is-current {
    color: var(--color-primary);
    border-color: var(--color-primary-bg-subdued-hover);
    background: var(--color-primary-bg-subdued);
    font-weight: var(--weight-medium);
  }

  @keyframes drawer-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__drawer {
      animation: none;
    }
  }

  @media (max-width: 1024px) {
    .nav__links ul {
      gap: 24px;
    }
  }

  @media (max-width: 880px) {
    .nav__links {
      display: none;
    }
    .nav__cta .nav__signin,
    .nav__language {
      display: none;
    }
    .nav__hamburger {
      display: flex;
      margin-left: auto;
    }
  }

  @media (max-width: 480px) {
    .nav__cta .btn {
      display: none;
    }

    .nav__drawer {
      padding-top: 20px;
      padding-bottom: max(24px, env(safe-area-inset-bottom));
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('.nav');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const drawer = document.querySelector<HTMLElement>('[data-nav-drawer]');

  if (toggle && drawer) {
    const closeDrawer = () => {
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute(
        'aria-label',
        toggle.dataset.openLabel || 'Open menu'
      );
      drawer.hidden = true;
      document.body.style.overflow = '';
    };

    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      if (expanded) {
        closeDrawer();
      } else {
        toggle.setAttribute('aria-expanded', 'true');
        toggle.setAttribute(
          'aria-label',
          toggle.dataset.closeLabel || 'Close menu'
        );
        drawer.hidden = false;
        document.body.style.overflow = 'hidden';
      }
    });

    drawer.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.matches('a')) {
        closeDrawer();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (
        e.key === 'Escape' &&
        toggle.getAttribute('aria-expanded') === 'true'
      ) {
        closeDrawer();
        toggle.focus();
      }
    });
  }

  const languageMenus =
    document.querySelectorAll<HTMLDetailsElement>('.nav__language');
  if (languageMenus.length) {
    document.addEventListener('click', (e) => {
      languageMenus.forEach((menu) => {
        if (!menu.contains(e.target as Node)) menu.open = false;
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        languageMenus.forEach((menu) => {
          if (menu.open) {
            menu.open = false;
            menu.querySelector<HTMLElement>('summary')?.focus();
          }
        });
      }
    });
  }

  if (nav) {
    const onScroll = () => {
      const y = window.scrollY;
      nav.dataset.scrolled = y > 8 ? 'true' : 'false';
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>
