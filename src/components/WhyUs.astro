---
/**
 * WhyUs.astro — 2×2 grid replacing fal.ai's speed card variant.
 *
 * A: current production model catalog mono grid.
 * B: 私有部署 / VPC 直连 schematic (240×160 box+arrow, indigo voltage on
 *    private boundary)
 * C: unified endpoint code diff (2 lines, indigo highlight on the swapped line)
 * D: 国内直连 latency schematic + city latency table (P50 placeholder)
 *
 * Decision 7b v2: D card swapped from "统一计费 / 人民币发票" (now lives in
 * §5 Built for Business) to a latency / 国内直连 demonstration.
 */

import { loadModels, totalModelCount } from '../data/pricing.ts';

const allModels = loadModels();
const total = totalModelCount();

/**
 * Marquee selection: 12 models spanning 6 vendors × 4 modalities. Chosen for
 * proof-of-breadth, not exhaustiveness — the full catalog lives at /models.
 * Picks complement FeaturedModels (top-6) by adding sibling sizes (mini /
 * sonnet / flash / haiku) and modality coverage (image, video).
 */
const marqueeIds = [
  'gpt-5.4',
  'gpt-5.4-mini',
  'claude-opus-4.7',
  'claude-sonnet-4.6',
  'gemini-3-pro-preview',
  'gemini-3-flash-preview',
  'DeepSeek-V3.2',
  'kimi-k2.6',
  'glm-5.1',
  'MiniMax-M2.7',
  'sora-2-pro',
  'nano-banana-pro-reverse',
];
const byId = new Map(allModels.map((m) => [m.model_name, m]));
const marquee = marqueeIds.map((id) => byId.get(id)).filter(Boolean) as typeof allModels;
const remaining = total - marquee.length;

const cities = [
  { city: '北京', p50: '142' },
  { city: '上海', p50: '128' },
  { city: '广州', p50: '156' },
  { city: '深圳', p50: '149' },
  { city: '杭州', p50: '134' },
];
---

<section class="why" id="why" aria-labelledby="why-title">
  <div class="container why__inner">
    <div class="why__header" data-reveal>
      <span class="eyebrow eyebrow--mute">WHY TOKENFLEET</span>
      <h2 class="why__title" id="why-title">
        为什么选 TokenFleet。
      </h2>
      <p class="why__body">
        四件可被验证的事，不是四条形容词。
      </p>
    </div>

    <div class="why__grid">
      {/* A — production models mono grid (12 marquee + folded link) */}
      <article class="whycard whycard--models" data-reveal style="--reveal-delay:0ms">
        <header class="whycard__head">
          <span class="eyebrow eyebrow--mute">A</span>
          <h3 class="whycard__title">{total} 个生产级模型，一个 endpoint</h3>
          <p class="whycard__body">覆盖 LLM、图像、视频、音频，通过统一 API 网关完成调用、计量与对账。</p>
        </header>
        <ul class="modelgrid mono">
          {marquee.map((model) => (
            <li class="modelgrid__cell">
              <span class="modelgrid__id">{model.model_name}</span>
              <span class="modelgrid__vendor">{model.vendor.name}</span>
            </li>
          ))}
        </ul>
        <a href="/models" class="modelgrid__more-link">
          <span>+{remaining}<span class="modelgrid__more-label"> 更多生产级模型</span></span>
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M4 2.5l3.5 3.5L4 9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </article>

      {/* B — Private VPC */}
      <article class="whycard whycard--vpc" data-reveal style="--reveal-delay:80ms">
        <header class="whycard__head">
          <span class="eyebrow eyebrow--mute">B</span>
          <h3 class="whycard__title">私有部署 / VPC 直连</h3>
          <p class="whycard__body">用量到达一定规模可申请 VPC 直连 endpoint，请求不离开你的私网边界。</p>
        </header>
        <div class="vpc" aria-hidden="true">
          <svg viewBox="0 0 360 210" fill="none" xmlns="http://www.w3.org/2000/svg" class="vpc-svg">
            <defs>
              <linearGradient id="vpc-private-grad" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="var(--color-primary-deep)" />
                <stop offset="100%" stop-color="var(--color-primary)" />
              </linearGradient>
            </defs>

            {/* ── PUBLIC row ─────────────────────────────────────────────── */}
            <g class="vpc-row vpc-row--public">
              <text x="180" y="20" text-anchor="middle" font-size="9" font-family="var(--font-mono)" fill="var(--color-ink-mute)" letter-spacing="1">PUBLIC INTERNET</text>

              {/* api endpoint */}
              <rect x="14" y="36" width="98" height="32" rx="4" fill="var(--color-canvas)" stroke="var(--color-hairline-strong)" stroke-width="1.1" />
              <text x="63" y="56" text-anchor="middle" font-size="10" font-family="var(--font-mono)" fill="var(--color-ink-secondary)">api endpoint</text>

              {/* dashed path through public cloud */}
              <path class="vpc-path vpc-path--public" d="M112 52 L168 52" stroke="var(--color-hairline-strong)" stroke-width="1.2" stroke-dasharray="3 3" />
              <path class="vpc-path vpc-path--public" d="M210 52 L262 52" stroke="var(--color-hairline-strong)" stroke-width="1.2" stroke-dasharray="3 3" />

              {/* internet cloud */}
              <g class="vpc-cloud">
                <path d="M174 56c-3-1.5-3-6 1-6 0-3.5 5-4.5 7-1 1.5-3 7-2.5 7 1 4 0 5 4 1.5 6z" fill="var(--color-canvas-soft)" stroke="var(--color-hairline-strong)" stroke-width="1" />
                <text x="189" y="68" text-anchor="middle" font-size="7" font-family="var(--font-mono)" fill="var(--color-ink-mute)">internet</text>
              </g>

              {/* your app (public side ghost) */}
              <rect x="262" y="36" width="86" height="32" rx="4" fill="var(--color-canvas)" stroke="var(--color-hairline-strong)" stroke-width="1.1" />
              <text x="305" y="56" text-anchor="middle" font-size="10" font-family="var(--font-mono)" fill="var(--color-ink-secondary)">your app</text>

              {/* slow dimming packets on the public line */}
              <g class="vpc-packets vpc-packets--public" fill="var(--color-ink-mute)">
                <circle class="vpc-pkt vpc-pkt--p0" cx="112" cy="52" r="2.4" />
                <circle class="vpc-pkt vpc-pkt--p1" cx="112" cy="52" r="2.4" />
              </g>
            </g>

            {/* ── PRIVATE VPC enclosure ────────────────────────────────── */}
            <g class="vpc-row vpc-row--private">
              {/* enclosure box — the private boundary */}
              <rect class="vpc-enclosure" x="6" y="100" width="348" height="102" rx="8"
                fill="var(--color-primary-bg-subdued)"
                fill-opacity="0.5"
                stroke="var(--color-primary)"
                stroke-width="1"
                stroke-dasharray="0"
              />

              <text x="14" y="118" font-size="9" font-family="var(--font-mono)" fill="var(--color-primary)" letter-spacing="1">PRIVATE · VPC</text>
              <text x="346" y="118" text-anchor="end" font-size="8.5" font-family="var(--font-mono)" fill="var(--color-primary-deep)" opacity="0.7">10.0.0.0/16</text>

              {/* vpc endpoint */}
              <rect x="20" y="138" width="98" height="36" rx="4" fill="var(--color-canvas)" stroke="var(--color-primary)" stroke-width="1.4" />
              <text x="69" y="155" text-anchor="middle" font-size="10" font-family="var(--font-mono)" fill="var(--color-primary)">vpc endpoint</text>
              <text x="69" y="167" text-anchor="middle" font-size="7.5" font-family="var(--font-mono)" fill="var(--color-primary)" opacity="0.6">eni-priv-0a32f</text>

              {/* direct private path */}
              <path class="vpc-path vpc-path--private" d="M118 156 L240 156" stroke="url(#vpc-private-grad)" stroke-width="1.6" />
              <path d="M240 156 L233 152 M240 156 L233 160" stroke="var(--color-primary)" stroke-width="1.6" stroke-linecap="round" />

              {/* your app inside the private enclosure */}
              <rect x="240" y="138" width="98" height="36" rx="4" fill="var(--color-canvas)" stroke="var(--color-primary)" stroke-width="1.4" />
              <text x="289" y="155" text-anchor="middle" font-size="10" font-family="var(--font-mono)" fill="var(--color-primary)">your app</text>
              <text x="289" y="167" text-anchor="middle" font-size="7.5" font-family="var(--font-mono)" fill="var(--color-primary)" opacity="0.6">vpc-app-prod</text>

              {/* fast indigo packets on the private line */}
              <g class="vpc-packets vpc-packets--private" fill="var(--color-primary)">
                <circle class="vpc-pkt vpc-pkt--q0" cx="118" cy="156" r="2.6" />
                <circle class="vpc-pkt vpc-pkt--q1" cx="118" cy="156" r="2.6" />
                <circle class="vpc-pkt vpc-pkt--q2" cx="118" cy="156" r="2.6" />
              </g>

              {/* tiny lock glyph on private path */}
              <g class="vpc-lock" transform="translate(176, 144)">
                <rect x="0" y="3" width="8" height="6" rx="1" fill="var(--color-canvas)" stroke="var(--color-primary)" stroke-width="1" />
                <path d="M2 3 V1.5 a2 2 0 0 1 4 0 V3" stroke="var(--color-primary)" stroke-width="1" fill="none" />
              </g>
            </g>
          </svg>
        </div>

        {/* spec strip — three micro-facts that fill the lower area with credibility */}
        <dl class="vpc-spec mono">
          <div class="vpc-spec__item">
            <dt>peering</dt>
            <dd>cn-shanghai-2 · cn-beijing-1</dd>
          </div>
          <div class="vpc-spec__item">
            <dt>encryption</dt>
            <dd>TLS 1.3 + mTLS</dd>
          </div>
          <div class="vpc-spec__item">
            <dt>egress</dt>
            <dd><span class="vpc-spec__dot" /> 不出私网</dd>
          </div>
        </dl>
      </article>

      {/* C — unified endpoint diff */}
      <article class="whycard whycard--diff" data-reveal style="--reveal-delay:160ms">
        <header class="whycard__head">
          <span class="eyebrow eyebrow--mute">C</span>
          <h3 class="whycard__title">统一 endpoint 接入</h3>
          <p class="whycard__body">同一个 API key 调用多家模型，接入路径与用量记录保持一致。</p>
        </header>
        <pre class="diff mono"><code><span class="diff__line diff__line--rm"><span class="diff__sign">−</span> base_url=<span class="diff__str">"https://api.openai.com/v1"</span></span>
<span class="diff__line diff__line--add"><span class="diff__sign">+</span> base_url=<span class="diff__str-on">"https://api.tokenfleet.cn/v1"</span><span class="diff__caret" aria-hidden="true"></span></span></code></pre>

        {/* live demo: same endpoint, model swaps every 2.4s */}
        <div class="endpoint-demo mono" data-endpoint-demo aria-hidden="true">
          <div class="endpoint-demo__row endpoint-demo__row--req">
            <span class="endpoint-demo__verb">POST</span>
            <span class="endpoint-demo__url">api.tokenfleet.cn/v1/chat/completions</span>
          </div>
          <div class="endpoint-demo__row endpoint-demo__row--model">
            <span class="endpoint-demo__key">model:</span>
            <span class="endpoint-demo__values">
              <span class="endpoint-demo__value is-active" data-vendor="openai">"gpt-5.4"</span>
              <span class="endpoint-demo__value" data-vendor="anthropic">"claude-opus-4.7"</span>
              <span class="endpoint-demo__value" data-vendor="google">"gemini-3-pro-preview"</span>
              <span class="endpoint-demo__value" data-vendor="deepseek">"DeepSeek-V3.2"</span>
              <span class="endpoint-demo__value" data-vendor="moonshot">"kimi-k2.6"</span>
            </span>
          </div>
          <div class="endpoint-demo__row endpoint-demo__row--status">
            <span class="endpoint-demo__pulse" />
            <span class="endpoint-demo__status">200 OK</span>
            <span class="endpoint-demo__vendor" data-current-vendor>via openai</span>
          </div>
        </div>

        <p class="whycard__caption mono">每月 token 用量、错误率、模型分布 → 控制台一站可见。</p>
      </article>

      {/* D — Domestic latency */}
      <article class="whycard whycard--latency" data-reveal style="--reveal-delay:240ms">
        <header class="whycard__head">
          <span class="eyebrow eyebrow--mute">D</span>
          <h3 class="whycard__title">国内直连，毫秒级延迟</h3>
          <p class="whycard__body">五大城市平均首字延迟（P50），按真实生产请求样本。</p>
        </header>
        <table class="latency mono">
          <thead>
            <tr>
              <th>城市</th>
              <th>P50</th>
              <th>
                <span class="latency__th-bar">
                  <span class="latency__th-tick latency__th-tick--zero">0</span>
                  <span class="latency__th-tick latency__th-tick--end">800ms</span>
                </span>
              </th>
            </tr>
          </thead>
          <tbody>
            {cities.map((c, i) => (
              <tr>
                <td>{c.city}</td>
                <td class="latency__num tabular">
                  <span class="latency__num-val" data-p50={c.p50}>{c.p50}</span>
                  <span class="latency__unit">ms</span>
                </td>
                <td class="latency__bar-cell">
                  <span
                    class="latency__bar"
                    style={`--w: ${(parseInt(c.p50) / 800) * 100}%; --delay: ${i * 80}ms;`}
                    aria-hidden="true"
                  ></span>
                </td>
              </tr>
            ))}
            <tr class="latency__row--ghost">
              <td>海外直连</td>
              <td class="latency__num latency__num--ghost tabular">≥ 800<span class="latency__unit">ms</span></td>
              <td class="latency__bar-cell">
                <span class="latency__bar latency__bar--ghost" style="--w: 100%; --delay: 480ms;" aria-hidden="true"></span>
              </td>
            </tr>
          </tbody>
        </table>
        <p class="whycard__caption mono">
          数据样本 2026-04 · <a href="https://status.tokenfleet.cn" rel="noopener noreferrer" target="_blank">查看 status</a>
        </p>
      </article>
    </div>
  </div>
</section>

<script>
  /* Card C endpoint demo: rotate the model value through 5 vendors, IO-gated. */
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const demo = document.querySelector<HTMLElement>('[data-endpoint-demo]');
  if (demo && !reduced) {
    const values = Array.from(demo.querySelectorAll<HTMLElement>('.endpoint-demo__value'));
    const vendorEl = demo.querySelector<HTMLElement>('[data-current-vendor]');
    let i = 0;
    let timer: number | undefined;
    const rotate = () => {
      const prev = values[i];
      i = (i + 1) % values.length;
      const next = values[i];
      prev.classList.remove('is-active');
      prev.classList.add('is-leaving');
      next.classList.add('is-active');
      if (vendorEl) vendorEl.textContent = `via ${next.dataset.vendor ?? ''}`;
      window.setTimeout(() => prev.classList.remove('is-leaving'), 320);
    };
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          if (timer === undefined) timer = window.setInterval(rotate, 2400);
        } else if (timer !== undefined) {
          window.clearInterval(timer);
          timer = undefined;
        }
      });
    }, { threshold: 0.25 });
    io.observe(demo);
  }

  /* Card D P50 fluctuation: each city's value jitters ±2ms on its own cadence.
     Random-walk bounded to ±2 from the base; tnum prevents digit jitter. */
  const p50Nodes = Array.from(document.querySelectorAll<HTMLElement>('.latency__num-val[data-p50]'));
  if (p50Nodes.length && !reduced) {
    const states = p50Nodes.map((node) => ({
      node,
      base: parseInt(node.dataset.p50 ?? '0', 10),
      offset: 0,
    }));
    let timer: number | undefined;
    const tick = () => {
      states.forEach((s, idx) => {
        // 65% chance to move, 35% chance to hold — feels organic
        if (Math.random() > 0.35) {
          const step = Math.random() < 0.5 ? -1 : 1;
          s.offset = Math.max(-2, Math.min(2, s.offset + step));
          const next = s.base + s.offset;
          s.node.textContent = String(next);
          s.node.classList.add('is-tick');
          window.setTimeout(() => s.node.classList.remove('is-tick'), 180 + idx * 20);
        }
      });
    };
    // run only while the latency card is visible (IO-gated for perf)
    const card = document.querySelector<HTMLElement>('.whycard--latency');
    if (card) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            if (timer === undefined) timer = window.setInterval(tick, 1400);
          } else if (timer !== undefined) {
            window.clearInterval(timer);
            timer = undefined;
          }
        });
      }, { threshold: 0.2 });
      io.observe(card);
    }
  }
</script>

<style>
  .why {
    background: var(--color-canvas-soft);
    border-top: 1px solid var(--color-hairline);
  }

  .why__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 5vw, 64px);
  }

  .why__header {
    max-width: 660px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .why__title {
    font-size: var(--type-display-lg-size);
    line-height: var(--type-display-lg-line);
    letter-spacing: var(--type-display-lg-track);
    font-weight: var(--weight-thin);
  }

  .why__body {
    color: var(--color-ink-mute);
    font-size: var(--type-body-md-size);
  }

  .why__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto;
    gap: 20px;
    min-width: 0;
  }

  /* per-card reveal stagger */
  .js-reveal .why__grid [data-reveal]:not(.is-visible),
  .js-reveal .why__grid [data-reveal].is-visible {
    transition-delay: var(--reveal-delay, 0ms);
  }

  .whycard {
    background: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    min-width: 0;
    transition: border-color var(--motion-base) var(--ease-out-quart),
                box-shadow var(--motion-base) var(--ease-out-quart);
  }

  .whycard:hover {
    border-color: var(--color-hairline-strong);
    box-shadow: var(--shadow-1);
  }

  .whycard__head {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .whycard__title {
    font-size: var(--type-heading-lg-size);
    line-height: 1.25;
    letter-spacing: -0.014em;
    font-weight: var(--weight-regular);
    color: var(--color-ink);
  }

  .whycard__body {
    color: var(--color-ink-secondary);
    font-size: 14px;
    line-height: 1.55;
    max-width: 44ch;
  }

  .whycard__caption {
    font-size: 11px;
    color: var(--color-ink-mute);
    margin-top: auto;
  }
  .whycard__caption a {
    color: var(--color-primary);
    border-bottom: 1px solid currentColor;
  }

  /* ── A: model grid ────────────────────────────────────────────────────── */
  .modelgrid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--color-hairline);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .modelgrid__cell {
    background: var(--color-canvas);
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    transition: background-color var(--motion-fast) var(--ease-out-quart);
    min-width: 0;
  }

  .modelgrid__cell:hover {
    background: var(--color-primary-bg-subdued);
  }

  .modelgrid__id {
    font-size: 11px;
    color: var(--color-ink);
    line-height: 1.2;
    letter-spacing: -0.01em;
    word-break: break-all;
  }

  .modelgrid__vendor {
    font-size: 9.5px;
    color: var(--color-ink-mute);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .modelgrid__more-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    align-self: flex-start;
    margin-top: auto;
    padding: 8px 0;
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: -0.005em;
    transition: gap var(--motion-base) var(--ease-out-quart),
                color var(--motion-base) var(--ease-out-quart);
  }
  .modelgrid__more-link:hover {
    gap: 10px;
    color: var(--color-primary-deep);
  }
  .modelgrid__more-label {
    color: var(--color-ink-mute);
    margin-left: 2px;
  }
  .modelgrid__more-link:hover .modelgrid__more-label {
    color: var(--color-ink-secondary);
  }

  /* ── B: VPC schematic ─────────────────────────────────────────────────── */
  .vpc {
    background: var(--color-canvas-soft);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    padding: 14px;
  }
  .vpc-svg { width: 100%; height: auto; max-height: 240px; display: block; }

  /* draw-in stroke for the private path */
  .vpc-path--private {
    stroke-dasharray: 130;
    stroke-dashoffset: 130;
    transition: stroke-dashoffset 900ms var(--ease-out-expo) 240ms;
  }
  .whycard--vpc.is-visible .vpc-path--private,
  html:not(.js-reveal) .whycard--vpc .vpc-path--private {
    stroke-dashoffset: 0;
  }

  /* enclosure soft pulse */
  .vpc-enclosure {
    transition: fill-opacity 320ms var(--ease-out-quart);
  }
  .whycard--vpc:hover .vpc-enclosure { fill-opacity: 0.75; }

  /* packets */
  .vpc-pkt {
    opacity: 0;
    animation-iteration-count: infinite;
    animation-timing-function: linear;
    animation-play-state: paused;
  }
  /* public — slow, dim, with mid-line opacity dip suggesting hop loss */
  .vpc-pkt--p0 { animation: vpc-pub 3.6s 0s; }
  .vpc-pkt--p1 { animation: vpc-pub 3.6s 1.8s; }
  /* private — fast, vivid, three of them in tight cadence */
  .vpc-pkt--q0 { animation: vpc-priv 1.6s 0s; }
  .vpc-pkt--q1 { animation: vpc-priv 1.6s 0.55s; }
  .vpc-pkt--q2 { animation: vpc-priv 1.6s 1.1s; }

  .whycard--vpc.is-visible .vpc-pkt,
  html:not(.js-reveal) .whycard--vpc .vpc-pkt {
    animation-play-state: running;
  }

  @keyframes vpc-pub {
    0%   { transform: translate(0, 0); opacity: 0; }
