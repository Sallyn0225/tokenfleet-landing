---
/**
 * WhyUs.astro — 2×2 grid replacing fal.ai's speed card variant.
 *
 * A: 34 个生产级模型 mono grid (35 cells, last one "+ 准备中" placeholder)
 * B: 私有部署 / VPC 直连 schematic (240×160 box+arrow, indigo voltage on
 *    private boundary)
 * C: OpenAI SDK code diff (2 lines, indigo highlight on the swapped line)
 * D: 国内直连 latency schematic + city latency table (P50 placeholder)
 *
 * Decision 7b v2: D card swapped from "统一计费 / 人民币发票" (now lives in
 * §5 Built for Business) to a latency / 国内直连 demonstration.
 */

const allModels = [
  // LLM 15
  ['claude-opus-4-7', 'Anthropic'],
  ['claude-sonnet-4-6', 'Anthropic'],
  ['claude-haiku-4-5', 'Anthropic'],
  ['gpt-5', 'OpenAI'],
  ['gpt-5-mini', 'OpenAI'],
  ['o3-pro', 'OpenAI'],
  ['gemini-3-pro', 'Google'],
  ['gemini-3-flash', 'Google'],
  ['deepseek-v3.5', 'DeepSeek'],
  ['deepseek-r1', 'DeepSeek'],
  ['qwen-3-max', 'Qwen'],
  ['qwen-3-coder', 'Qwen'],
  ['mistral-large-2', 'Mistral'],
  ['llama-4-405b', 'Meta'],
  ['yi-lightning', '01.AI'],
  // 图像 10
  ['flux-1.1-pro', 'BFL'],
  ['flux-1.1-pro-ultra', 'BFL'],
  ['sd-3.5-large', 'Stability'],
  ['ideogram-3', 'Ideogram'],
  ['recraft-v3', 'Recraft'],
  ['midjourney-7', 'via fal'],
  ['dall-e-3', 'OpenAI'],
  ['seedream-3.0', 'ByteDance'],
  ['wanxiang-2.1', 'Alibaba'],
  ['cogview-4', 'Zhipu'],
  // 视频 6
  ['sora-2', 'OpenAI'],
  ['kling-2.0', 'Kuaishou'],
  ['runway-gen-4', 'Runway'],
  ['veo-3', 'Google'],
  ['minimax-i2v-01', 'MiniMax'],
  ['luma-dream-machine', 'Luma'],
  // 音频 3
  ['eleven-v3', 'ElevenLabs'],
  ['cosyvoice-2', 'Alibaba'],
  ['whisper-large-v3', 'OpenAI'],
];

const cities = [
  { city: '北京', p50: '142' },
  { city: '上海', p50: '128' },
  { city: '广州', p50: '156' },
  { city: '深圳', p50: '149' },
  { city: '杭州', p50: '134' },
];
---

<section class="why" id="why" aria-labelledby="why-title">
  <div class="container why__inner">
    <div class="why__header" data-reveal>
      <span class="eyebrow eyebrow--mute">WHY TOKENFLEET</span>
      <h2 class="why__title" id="why-title">
        为什么选 TokenFleet。
      </h2>
      <p class="why__body">
        四件可被验证的事，不是四条形容词。
      </p>
    </div>

    <div class="why__grid" data-reveal>
      {/* A — 34 models mono grid */}
      <article class="whycard whycard--models">
        <header class="whycard__head">
          <span class="eyebrow eyebrow--mute">A</span>
          <h3 class="whycard__title">34 个生产级模型，一个 endpoint</h3>
          <p class="whycard__body">覆盖 LLM、图像、视频、音频，全部 OpenAI Chat / Images / Audio API 接口形态。</p>
        </header>
        <ul class="modelgrid mono">
          {allModels.map(([id, vendor]) => (
            <li class="modelgrid__cell">
              <span class="modelgrid__id">{id}</span>
              <span class="modelgrid__vendor">{vendor}</span>
            </li>
          ))}
          <li class="modelgrid__cell modelgrid__cell--more">
            <a href="/models" class="modelgrid__more">浏览全部 →</a>
          </li>
        </ul>
      </article>

      {/* B — Private VPC */}
      <article class="whycard whycard--vpc">
        <header class="whycard__head">
          <span class="eyebrow eyebrow--mute">B</span>
          <h3 class="whycard__title">私有部署 / VPC 直连</h3>
          <p class="whycard__body">用量到达一定规模可申请 VPC 直连 endpoint，请求不离开你的私网边界。</p>
        </header>
        <div class="vpc" aria-hidden="true">
          <svg viewBox="0 0 320 180" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <pattern id="dottedLine" width="6" height="2" patternUnits="userSpaceOnUse">
                <rect width="3" height="1" fill="var(--color-ink-mute)" />
              </pattern>
            </defs>

            {/* Public arrow (above) */}
            <g>
              <text x="160" y="30" text-anchor="middle" font-size="10" font-family="var(--font-mono)" fill="var(--color-ink-mute)">PUBLIC</text>
              <rect x="20" y="46" width="80" height="32" rx="4" fill="var(--color-canvas)" stroke="var(--color-hairline-strong)" stroke-width="1.2" />
              <text x="60" y="66" text-anchor="middle" font-size="10" font-family="var(--font-mono)" fill="var(--color-ink-secondary)">api endpoint</text>

              <path d="M100 62 L220 62" stroke="var(--color-hairline-strong)" stroke-width="1.2" stroke-dasharray="4 4" />
              <path d="M220 62 L214 58 M220 62 L214 66" stroke="var(--color-hairline-strong)" stroke-width="1.2" stroke-linecap="round" />

              <rect x="220" y="46" width="80" height="32" rx="4" fill="var(--color-canvas)" stroke="var(--color-hairline-strong)" stroke-width="1.2" />
              <text x="260" y="66" text-anchor="middle" font-size="10" font-family="var(--font-mono)" fill="var(--color-ink-secondary)">your app</text>
            </g>

            {/* Private VPC arrow (below) */}
            <g>
              <text x="160" y="118" text-anchor="middle" font-size="10" font-family="var(--font-mono)" fill="var(--color-primary)">PRIVATE · VPC</text>
              <rect x="20" y="134" width="80" height="32" rx="4" fill="var(--color-primary-bg-subdued)" stroke="var(--color-primary)" stroke-width="1.4" />
              <text x="60" y="154" text-anchor="middle" font-size="10" font-family="var(--font-mono)" fill="var(--color-primary)">vpc endpoint</text>

              <path d="M100 150 L220 150" stroke="var(--color-primary)" stroke-width="1.4" />
              <path d="M220 150 L214 146 M220 150 L214 154" stroke="var(--color-primary)" stroke-width="1.4" stroke-linecap="round" />

              <rect x="220" y="134" width="80" height="32" rx="4" fill="var(--color-primary-bg-subdued)" stroke="var(--color-primary)" stroke-width="1.4" />
              <text x="260" y="154" text-anchor="middle" font-size="10" font-family="var(--font-mono)" fill="var(--color-primary)">your app</text>
            </g>
          </svg>
        </div>
      </article>

      {/* C — OpenAI SDK diff */}
      <article class="whycard whycard--diff">
        <header class="whycard__head">
          <span class="eyebrow eyebrow--mute">C</span>
          <h3 class="whycard__title">OpenAI SDK 即插即用</h3>
          <p class="whycard__body">一行替换，零代码改动。Python / Node 同样兼容。</p>
        </header>
        <pre class="diff mono"><code><span class="diff__line diff__line--rm"><span class="diff__sign">−</span> base_url=<span class="diff__str">"https://api.openai.com/v1"</span></span>
<span class="diff__line diff__line--add"><span class="diff__sign">+</span> base_url=<span class="diff__str-on">"https://api.tokenfleet.cn/v1"</span></span></code></pre>
        <p class="whycard__caption mono">每月 token 用量、错误率、模型分布 → 控制台一站可见。</p>
      </article>

      {/* D — Domestic latency */}
      <article class="whycard whycard--latency">
        <header class="whycard__head">
          <span class="eyebrow eyebrow--mute">D</span>
          <h3 class="whycard__title">国内直连，毫秒级延迟</h3>
          <p class="whycard__body">五大城市平均首字延迟（P50），按真实生产请求样本。</p>
        </header>
        <table class="latency mono">
          <thead>
            <tr>
              <th>城市</th>
              <th>P50</th>
              <th>对照</th>
            </tr>
          </thead>
          <tbody>
            {cities.map((c, i) => (
              <tr>
                <td>{c.city}</td>
                <td class="latency__num tabular">{c.p50} <span class="latency__unit">ms</span></td>
                <td>
                  <span
                    class="latency__bar"
                    style={`--w: ${Math.min(100, parseInt(c.p50) / 2)}%;`}
                    aria-hidden="true"
                  ></span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="whycard__caption mono">
          数据样本 2026-04 · 海外直连典型 ≥ 800ms · <a href="https://status.tokenfleet.cn" rel="noopener noreferrer" target="_blank">查看 status</a>
        </p>
      </article>
    </div>
  </div>
</section>

<style>
  .why {
    background: var(--color-canvas-soft);
    border-top: 1px solid var(--color-hairline);
  }

  .why__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 5vw, 64px);
  }

  .why__header {
    max-width: 660px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .why__title {
    font-size: var(--type-display-lg-size);
    line-height: var(--type-display-lg-line);
    letter-spacing: var(--type-display-lg-track);
    font-weight: var(--weight-thin);
  }

  .why__body {
    color: var(--color-ink-mute);
    font-size: var(--type-body-md-size);
  }

  .why__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto;
    gap: 20px;
    min-width: 0;
  }

  /* card A spans 2 rows on desktop for taller models grid */
  .whycard--models { grid-row: span 2; }

  .whycard {
    background: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    min-width: 0;
    transition: border-color var(--motion-base) var(--ease-out-quart),
                box-shadow var(--motion-base) var(--ease-out-quart);
  }

  .whycard:hover {
    border-color: var(--color-hairline-strong);
    box-shadow: var(--shadow-1);
  }

  .whycard__head {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .whycard__title {
    font-size: var(--type-heading-lg-size);
    line-height: 1.25;
    letter-spacing: -0.014em;
    font-weight: var(--weight-regular);
    color: var(--color-ink);
  }

  .whycard__body {
    color: var(--color-ink-secondary);
    font-size: 14px;
    line-height: 1.55;
    max-width: 44ch;
  }

  .whycard__caption {
    font-size: 11px;
    color: var(--color-ink-mute);
    margin-top: auto;
  }
  .whycard__caption a {
    color: var(--color-primary);
    border-bottom: 1px solid currentColor;
  }

  /* ── A: model grid ────────────────────────────────────────────────────── */
  .modelgrid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--color-hairline);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    overflow: hidden;
    flex: 1;
  }

  .modelgrid__cell {
    background: var(--color-canvas);
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    transition: background-color var(--motion-fast) var(--ease-out-quart);
    min-width: 0;
  }

  .modelgrid__cell:hover {
    background: var(--color-primary-bg-subdued);
  }

  .modelgrid__id {
    font-size: 11px;
    color: var(--color-ink);
    line-height: 1.2;
    letter-spacing: -0.01em;
    word-break: break-all;
  }

  .modelgrid__vendor {
    font-size: 9.5px;
    color: var(--color-ink-mute);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .modelgrid__cell--more {
    background: var(--color-canvas-soft);
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    padding: 0;
  }
  .modelgrid__more {
    font-size: 10px;
    font-weight: var(--weight-medium);
    color: var(--color-primary);
    width: 100%;
    height: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 6px;
    transition: background-color var(--motion-base) var(--ease-out-quart);
  }
  .modelgrid__more:hover {
    background: var(--color-primary-bg-subdued);
  }

  /* ── B: VPC schematic ─────────────────────────────────────────────────── */
  .vpc {
    background: var(--color-canvas-soft);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    padding: 14px;
  }
  .vpc svg { width: 100%; height: auto; max-height: 200px; }

  /* ── C: diff block ────────────────────────────────────────────────────── */
  .diff {
    margin: 0;
    background: var(--color-canvas-soft);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    padding: 18px 16px;
    font-size: 13px;
    line-height: 1.7;
    color: var(--color-ink);
    overflow-x: auto;
  }

  .diff__line {
    display: block;
    padding: 1px 8px;
    border-radius: var(--radius-xs);
    white-space: pre;
  }

  .diff__line--rm {
    background: rgba(234, 34, 97, 0.05);
    color: var(--color-ink-mute);
    text-decoration: line-through;
    text-decoration-thickness: 1px;
    text-decoration-color: rgba(234, 34, 97, 0.5);
  }

  .diff__line--add {
    background: var(--color-primary-bg-subdued);
    color: var(--color-ink);
    margin-top: 4px;
  }

  .diff__sign {
    color: var(--color-ink-mute);
    margin-right: 8px;
  }
  .diff__line--add .diff__sign { color: var(--color-primary); }

  .diff__str { color: var(--color-lemon); }
  .diff__str-on { color: var(--color-primary); font-weight: var(--weight-medium); }

  /* ── D: latency table ─────────────────────────────────────────────────── */
  .latency {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
    color: var(--color-ink-secondary);
  }
  .latency th {
    text-align: left;
    font-weight: var(--weight-regular);
    color: var(--color-ink-mute);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 10px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--color-hairline);
  }
  .latency td {
    padding: 9px 0;
    border-bottom: 1px solid var(--color-hairline);
  }
  .latency tbody tr:last-child td { border-bottom: 0; }
  .latency__num { color: var(--color-ink); font-weight: var(--weight-medium); white-space: nowrap; }
  .latency__unit { color: var(--color-ink-mute); font-weight: var(--weight-regular); margin-left: 2px; font-size: 10px; }
  .latency__bar {
    display: block;
    height: 4px;
    width: var(--w);
    background: var(--color-primary);
    border-radius: 999px;
    min-width: 8px;
  }

  /* ── responsive ───────────────────────────────────────────────────────── */
  @media (max-width: 920px) {
    .why__grid {
      grid-template-columns: 1fr;
    }
    .whycard--models { grid-row: auto; }
    .modelgrid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 480px) {
    .whycard { padding: 22px 20px; }
    .modelgrid {
      grid-template-columns: 1fr;
    }
    .diff__line {
      width: max-content;
      min-width: 100%;
    }
  }
</style>
