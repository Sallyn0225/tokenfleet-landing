---
/**
 * ModelDialog.astro — single shared <dialog> for model detail.
 *
 * Markup contains an empty shell. ModelsExplorer's vanilla JS reads the
 * embedded `data-models` JSON map and rewrites the dialog's innerHTML when
 * a card is clicked, then calls dialog.showModal().
 *
 * Keeping the data inside the page (vs in a Map<>) means the dialog stays
 * crawlable for accessibility tools that snapshot the DOM after open.
 */
import type { Model } from '../data/pricing.ts';
import {
  loadModels,
  priceBreakdown,
  modalityLabel,
  fmtUsd,
  endpointDefs,
  vendorDisplayName,
} from '../data/pricing.ts';
import { metaOf } from '../data/model-meta.ts';
import { i18n, type Locale } from '../i18n.ts';

interface Props {
  locale?: Locale;
}

const { locale = 'zh' } = Astro.props as Props;
const t = i18n[locale];
const models = loadModels();

// Serialize a compact lookup of pre-rendered detail HTML so the dialog open
// is purely DOM-swap; avoids client-side templating.
function renderDetail(m: Model): string {
  const meta = metaOf(m.model_name);
  const p = priceBreakdown(m);
  const vendorName = vendorDisplayName(m.vendor, locale);
  const tag =
    m.tags && (locale === 'zh' || !/[\u3400-\u9fff]/.test(m.tags))
      ? ` · ${escapeHtml(m.tags)}`
      : '';

  const specRows: string[] = [];
  if (meta?.contextK)
    specRows.push(
      `<dt>${t.models.context}</dt><dd class="mono">${meta.contextK >= 1000 ? meta.contextK / 1000 + 'M' : meta.contextK + 'K'} tokens</dd>`
    );
  if (meta?.maxOutputK)
    specRows.push(
      `<dt>${t.models.maxOutput}</dt><dd class="mono">${meta.maxOutputK}K tokens</dd>`
    );
  specRows.push(
    `<dt>${t.models.billing}</dt><dd class="mono">${p.kind === 'token' ? t.models.billingToken : t.models.billingCall}</dd>`
  );
  specRows.push(
    `<dt>${t.models.groups}</dt><dd class="mono">${m.enable_groups.map(escapeHtml).join(' · ')}</dd>`
  );

  const endpoints = m.supported_endpoint_types
    .map((e) => {
      const def = endpointDefs[e];
      return `<li><span class="endpoint__name mono">${escapeHtml(e)}</span><span class="endpoint__path mono">${escapeHtml(def?.path ?? '')}</span></li>`;
    })
    .join('');

  let priceTable = '';
  if (p.kind === 'token') {
    if (p.tiers) {
      priceTable = `
        <table class="price-table mono">
          <thead><tr><th>${t.models.range}</th><th>${t.models.inputPerM}</th><th>${t.models.outputPerM}</th></tr></thead>
          <tbody>
            ${p.tiers.map((t) => `<tr><td>${escapeHtml(t.label)}</td><td>${fmtUsd(t.inputUsd)}</td><td>${fmtUsd(t.outputUsd)}</td></tr>`).join('')}
          </tbody>
        </table>
        ${p.cachedInputUsd !== undefined ? `<p class="price-note mono">${t.models.cachedInput} · ${fmtUsd(p.cachedInputUsd)} / 1M tokens</p>` : ''}
      `;
    } else {
      priceTable = `
        <table class="price-table mono">
          <tbody>
            <tr><th>${t.models.input}</th><td>${fmtUsd(p.inputUsd)} / 1M tokens</td></tr>
            <tr><th>${t.models.output}</th><td>${fmtUsd(p.outputUsd!)} / 1M tokens</td></tr>
            ${p.cachedInputUsd !== undefined ? `<tr><th>${t.models.cachedInput}</th><td>${fmtUsd(p.cachedInputUsd)} / 1M tokens</td></tr>` : ''}
            ${p.createCacheUsd !== undefined ? `<tr><th>${t.models.cacheWrite}</th><td>${fmtUsd(p.createCacheUsd)} / 1M tokens</td></tr>` : ''}
          </tbody>
        </table>
      `;
    }
  } else {
    priceTable = `
      <table class="price-table mono">
        <tbody><tr><th>${t.models.perCall}</th><td>${fmtUsd(p.inputUsd)} / ${t.models.pricePerCall}</td></tr></tbody>
      </table>
    `;
  }

  const canUseDescription =
    Boolean(m.description) &&
    (locale === 'zh' || !/[\u3400-\u9fff]/.test(m.description ?? ''));
  const description =
    canUseDescription && m.description
      ? `<p class="dialog__desc">${escapeHtml(m.description).replace(/\n/g, '<br />')}</p>`
      : `<p class="dialog__desc dialog__desc--mute">${t.models.noDescription}</p>`;

  const docsLink = meta?.docs
    ? `<a class="link dialog__docs" href="${escapeHtml(meta.docs)}" target="_blank" rel="noopener noreferrer">${t.models.docs}</a>`
    : '';

  return `
    <header class="dialog__head">
      <span class="dialog__logo">
        <img src="${escapeHtml(m.iconUrl)}" alt="${escapeHtml(vendorName)} logo" onerror="this.style.display='none'" />
      </span>
      <div class="dialog__heading">
        <span class="dialog__vendor mono">${escapeHtml(vendorName)}</span>
        <h2 class="dialog__title mono" id="dialog-title">${escapeHtml(m.model_name)}</h2>
        <span class="dialog__modality mono">${modalityLabel(m.modality, locale)}${tag}</span>
      </div>
      <button type="button" class="dialog__close" data-dialog-close aria-label="${t.models.close}">×</button>
    </header>

    <div class="dialog__body">
      <div class="dialog__section">
        <h3 class="dialog__h3 eyebrow eyebrow--mute">${t.models.detailIntro}</h3>
        ${description}
        ${docsLink}
      </div>

      <div class="dialog__section">
        <h3 class="dialog__h3 eyebrow eyebrow--mute">${t.models.price}</h3>
        ${priceTable}
      </div>

      <div class="dialog__section">
        <h3 class="dialog__h3 eyebrow eyebrow--mute">${t.models.specs}</h3>
        <dl class="dialog__specs">${specRows.join('')}</dl>
      </div>

      <div class="dialog__section">
        <h3 class="dialog__h3 eyebrow eyebrow--mute">${t.models.endpoints}</h3>
        <ul class="endpoint-list">${endpoints}</ul>
      </div>
    </div>

    <footer class="dialog__foot">
      <button type="button" class="btn btn--outline btn--sm" data-copy-id data-id="${escapeHtml(m.model_name)}">${t.models.copyId}</button>
      <a class="btn btn--primary btn--sm" href="https://tokenfleet.cn/dashboard/" rel="noopener">${t.models.console}</a>
    </footer>
  `;
}

function escapeHtml(s: string): string {
  return s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

const detailMap: Record<string, string> = {};
models.forEach((m) => {
  detailMap[m.model_name] = renderDetail(m);
});
const detailJson = JSON.stringify(detailMap);
---

<dialog class="modeldialog" id="model-dialog" aria-labelledby="dialog-title">
  <div class="modeldialog__inner" data-dialog-inner>
    {/* JS will inject pre-rendered detail HTML here */}
  </div>
</dialog>

<script type="application/json" id="model-detail-data" set:html={detailJson} />

<style>
  .modeldialog {
    position: fixed;
    inset: 0;
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: var(--radius-lg);
    width: min(640px, calc(100vw - 32px));
    max-height: calc(100vh - 64px);
    max-height: calc(100dvh - 64px);
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: 0 24px 60px rgba(0, 55, 112, 0.22);
    overflow: hidden;
  }

  .modeldialog::backdrop {
    background: rgba(13, 37, 61, 0.42);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .modeldialog__inner {
    display: flex;
    flex-direction: column;
    min-height: 0;
    max-height: inherit;
  }

  :global(.modeldialog .dialog__head) {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 22px 22px 16px;
    border-bottom: 1px solid var(--color-hairline);
  }

  :global(.modeldialog .dialog__logo) {
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: var(--color-canvas-soft);
    border: 1px solid var(--color-hairline);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  :global(.modeldialog .dialog__logo img) {
    width: 24px;
    height: 24px;
    object-fit: contain;
  }

  :global(.modeldialog .dialog__heading) {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  :global(.modeldialog .dialog__vendor) {
    font-size: 11px;
    color: var(--color-ink-mute);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  :global(.modeldialog .dialog__title) {
    font-size: 20px;
    font-weight: var(--weight-medium);
    letter-spacing: -0.015em;
    color: var(--color-ink);
    word-break: break-all;
  }

  :global(.modeldialog .dialog__modality) {
    font-size: 11px;
    color: var(--color-ink-secondary);
    letter-spacing: 0.04em;
  }

  :global(.modeldialog .dialog__close) {
    width: 32px;
    height: 32px;
    border-radius: 999px;
    color: var(--color-ink-mute);
    font-size: 22px;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition:
      background-color var(--motion-base) var(--ease-out-quart),
      color var(--motion-base) var(--ease-out-quart);
    flex-shrink: 0;
  }
  :global(.modeldialog .dialog__close:hover) {
    background: var(--color-canvas-soft);
    color: var(--color-ink);
  }

  :global(.modeldialog .dialog__body) {
    overflow-y: auto;
    padding: 20px 22px 8px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    min-height: 0;
  }

  :global(.modeldialog .dialog__section) {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  :global(.modeldialog .dialog__h3) {
    margin-bottom: 2px;
  }

  :global(.modeldialog .dialog__desc) {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--color-ink-secondary);
    white-space: pre-line;
  }
  :global(.modeldialog .dialog__desc--mute) {
    color: var(--color-ink-mute);
    font-style: italic;
  }

  :global(.modeldialog .dialog__docs) {
    align-self: flex-start;
    font-size: 12.5px;
  }

  :global(.modeldialog .price-table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  :global(.modeldialog .price-table th),
  :global(.modeldialog .price-table td) {
    padding: 8px 10px;
    border-bottom: 1px solid var(--color-hairline);
    text-align: left;
    color: var(--color-ink-secondary);
  }
  :global(.modeldialog .price-table thead th) {
    font-size: 11px;
    color: var(--color-ink-mute);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border-bottom: 1px solid var(--color-hairline-strong);
  }
  :global(.modeldialog .price-table tbody tr:last-child td),
  :global(.modeldialog .price-table tbody tr:last-child th) {
    border-bottom: 0;
  }
  :global(.modeldialog .price-table th[scope='row']),
  :global(.modeldialog .price-table tbody th) {
    color: var(--color-ink-mute);
    font-weight: var(--weight-regular);
    width: 40%;
  }
  :global(.modeldialog .price-note) {
    font-size: 12px;
    color: var(--color-ink-mute);
    margin-top: 4px;
  }

  :global(.modeldialog .dialog__specs) {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 8px 16px;
    font-size: 13px;
  }
  :global(.modeldialog .dialog__specs dt) {
    color: var(--color-ink-mute);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding-top: 2px;
  }
  :global(.modeldialog .dialog__specs dd) {
    margin: 0;
    color: var(--color-ink);
  }

  :global(.modeldialog .endpoint-list) {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  :global(.modeldialog .endpoint-list li) {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 12.5px;
  }
  :global(.modeldialog .endpoint__name) {
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    background: var(--color-primary-bg-subdued);
    color: var(--color-primary-deep);
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  :global(.modeldialog .endpoint__path) {
    color: var(--color-ink-mute);
    word-break: break-all;
  }

  :global(.modeldialog .dialog__foot) {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    padding: 16px 22px;
    border-top: 1px solid var(--color-hairline);
    background: var(--color-canvas-soft);
  }

  @media (max-width: 520px) {
    .modeldialog {
      width: 100vw;
      max-width: 100vw;
      max-height: 100vh;
      max-height: 100dvh;
      border-radius: 0;
      margin: 0;
    }
    .modeldialog__inner {
      max-height: 100dvh;
    }
    :global(.modeldialog .dialog__head) {
      padding: 16px 16px 14px;
    }
    :global(.modeldialog .dialog__body) {
      padding: 16px 16px 8px;
    }
    :global(.modeldialog .dialog__foot) {
      padding: 14px 16px;
    }
  }
</style>
