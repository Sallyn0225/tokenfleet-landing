---
/**
 * HeroBackdrop.astro — light purple terminal hero background.
 *
 * Renders a white-purple fallback for SSR / WebGL-disabled clients, then
 * hydrates the FaultyTerminal WebGL canvas on top via client:only="react".
 *
 * Replaces MeshBackdrop on the home hero only; mesh remains the universal
 * marketing-hero default elsewhere (see DESIGN.md §"do's and don'ts").
 */

import FaultyTerminalIsland from './react/FaultyTerminalIsland.jsx';
---

<div class="hero-bg" aria-hidden="true">
  <div class="hero-bg__fallback"></div>

  <FaultyTerminalIsland
    client:only="react"
    scale={3}
    gridMul={[2, 1]}
    digitSize={0.9}
    timeScale={0.58}
    pause={false}
    scanlineIntensity={0.48}
    glitchAmount={0.22}
    flickerAmount={0.16}
    noiseAmp={0.62}
    chromaticAberration={0}
    dither={0}
    curvature={0}
    tint="#5b42ff"
    backgroundColor="#f8f6ff"
    mouseReact={true}
    mouseStrength={0.32}
    pageLoadAnimation={false}
    brightness={0.58}
    dpr={1}
  />

  <div class="hero-bg__vignette"></div>
</div>

<style>
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: var(--z-mesh);
    overflow: hidden;
    background: #f8f6ff;
    contain: layout paint;
    pointer-events: none;
  }

  /* Static fallback shown before React hydrates / when WebGL is unavailable.
     Mirrors the light-with-purple-energy tone the canvas will paint over. */
  .hero-bg__fallback {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse at 18% 24%,
        rgba(125, 109, 255, 0.28),
        transparent 62%
      ),
      radial-gradient(
        ellipse at 82% 72%,
        rgba(249, 107, 238, 0.14),
        transparent 58%
      ),
      radial-gradient(
        ellipse at 52% 8%,
        rgba(255, 255, 255, 0.82),
        transparent 52%
      ),
      #f8f6ff;
    pointer-events: none;
  }

  /* Soft edge wash so the canvas doesn't hard-cut against the centered content. */
  .hero-bg__vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at 50% 60%,
      rgba(255, 255, 255, 0) 34%,
      rgba(255, 255, 255, 0.18) 78%,
      rgba(255, 255, 255, 0.42) 100%
    );
    pointer-events: none;
  }

  .hero-bg :global(canvas) {
    display: block;
    opacity: 0.94;
    animation: hero-bg-canvas-in 420ms ease-out both;
    will-change: opacity;
  }

  @keyframes hero-bg-canvas-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 0.94;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-bg :global(canvas) {
      animation: none;
      opacity: 0.86;
    }
  }
</style>
