---
import BrandLogoLoop from './react/BrandLogoLoop.jsx';
import { i18n, type Locale } from '../i18n.ts';

interface Props {
  locale?: Locale;
}

const { locale = 'zh' } = Astro.props as Props;
const t = i18n[locale];
---

<section class="brandstrip" aria-labelledby="brandstrip-title">
  <div class="container brandstrip__inner">
    <p class="eyebrow eyebrow--mute" id="brandstrip-title">
      {t.brandStrip.title}
    </p>
    <div class="brandstrip__loop">
      <BrandLogoLoop ariaLabel={t.brandStrip.aria} client:visible />
    </div>
  </div>
</section>

<style>
  .brandstrip {
    background: var(--color-canvas);
    padding-block: clamp(24px, 3vw, 40px);
    border-top: 1px solid var(--color-hairline);
    border-bottom: 1px solid var(--color-hairline);
  }

  .brandstrip__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(18px, 2.2vw, 28px);
  }

  .brandstrip__loop {
    position: relative;
    height: clamp(64px, 7vw, 92px);
    color: var(--color-ink);
    display: flex;
    align-items: center;
  }

  .brandstrip__loop :global(.logoloop) {
    flex: 1 1 auto;
  }

  .brandstrip__loop :global(.logoloop img) {
    height: clamp(52px, 5.2vw, 72px) !important;
    width: auto;
  }

  @media (max-width: 640px) {
    .brandstrip {
      padding-block: 22px 28px;
    }

    .brandstrip__loop {
      height: 64px;
    }

    .brandstrip__loop :global(.logoloop img) {
      height: 48px !important;
    }
  }
</style>
